{
  "name": "wlgofficebot",
  "version": "0.7.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "shevernitskiy <mahahuha@ya.ru>",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun --env-file=.env.development src/main.ts",
    "build:windows": "bun build --env-file=.env.development --env=inline --compile --target=bun-windows-x64 ./src/main.ts --outfile dist/wlgofficebot.exe",
    "build:linux": "bun build --env-file=.env --env=inline --compile --target=bun-linux-x64 ./src/main.ts --outfile dist/wlgofficebot",
    "build:linux-arm": "bun build --env-file=.env --env=inline --compile --target=bun-linux-arm64 ./src/main.ts --outfile dist/wlgofficebot-arm",
    "upload": "bun build:linux && bun E:/deploy.ts ./dist/wlgofficebot /opt/bots/wlgoffice/wlgofficebot wlgoffice",
    "format": "bun fmt",
    "check": "bun check"
  },
  "dependencies": {
    "@mtcute/bun": "^0.32.0",
    "@mtcute/dispatcher": "^0.32.0",
    "@shevernitskiy/llm": "npm:@jsr/shevernitskiy__llm@^0.0.28",
    "@shevernitskiy/scraperator": "npm:@jsr/shevernitskiy__scraperator@^0.0.143"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
